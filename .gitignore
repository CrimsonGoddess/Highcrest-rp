# Secrets
server-data/secrets.cfg
database/client.cnf

# Transfer package, which contains player data
deploy/

# Binaries, fetched by the setup steps in README.md
artifacts/
database/mariadb/

# Runtime data
database/data/
database/my.ini
server-data/cache/
server-data/tmp/
*.log

# Downloaded scripts waiting to be reviewed and installed
Scripts/

# RFC Mapping maps (large, uploaded directly, not in git)
server-data/resources/[[]assets]/rfc_*/

# RTX Shell Creator: bought resource + server-written shells; only our config is tracked
server-data/resources/[[]rtx]/*
!server-data/resources/[[]rtx]/rtx_shellcreator/
server-data/resources/[[]rtx]/rtx_shellcreator/*
!server-data/resources/[[]rtx]/rtx_shellcreator/config.lua
